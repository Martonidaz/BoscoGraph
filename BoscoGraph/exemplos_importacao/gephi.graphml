<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <key attr.name="label" attr.type="string" for="node" id="label"/>
  <key attr.name="x" attr.type="float" for="node" id="x"/>
  <key attr.name="y" attr.type="float" for="node" id="y"/>
  <key attr.name="Weight" attr.type="double" for="edge" id="weight"/>
  <graph edgedefault="undirected">
    <node id="1"><data key="label">Ana</data><data key="x">0.0</data><data key="y">0.0</data></node>
    <node id="2"><data key="label">Bruno</data><data key="x">100.0</data><data key="y">50.0</data></node>
    <node id="3"><data key="label">Carla</data><data key="x">200.0</data><data key="y">0.0</data></node>
    <node id="4"><data key="label">Ana</data><data key="x">100.0</data><data key="y">-60.0</data></node>
    <edge source="1" target="2"><data key="weight">1.0</data></edge>
    <edge source="2" target="3"><data key="weight">3.0</data></edge>
    <edge source="3" target="4" directed="true"><data key="weight">2.0</data></edge>
    <hyperedge><endpoint node="1"/><endpoint node="2"/><endpoint node="3"/></hyperedge>
  </graph>
</graphml>
